{# @var paginator \EasyCorp\Bundle\EasyAdminBundle\Orm\EntityPaginatorInterface #}
{# Reuses vendor's own pagination links (see @EasyAdmin/crud/paginator.html.twig) so the page
   navigation UI never drifts from vendor's; only appends the page-size selector. #}
<twig:ea:Pagination
    paginator="{{ paginator }}"
    showResultsCount="{{ render_detailed_pagination ?? true }}"
    showPageNumbers="{{ render_detailed_pagination ?? true }}"
/>

{% set ea_extensions_pagination_sizes = ea_extensions_pagination_available_page_sizes() %}
{% if ea_extensions_pagination_sizes is not empty and not ea_extensions_pagination_is_embedded() %}
    <select class="form-select mx-2" style="width: auto; display: inline-block;" data-controller="ea-extensions--pagination-page-size" data-action="ea-extensions--pagination-page-size#navigate">
        {% for option in ea_extensions_pagination_sizes %}
            <option value="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({(ea_extensions_pagination_query_parameter()): option})) }}" {{ paginator.pageSize == option ? 'selected' : '' }}>
                {{ option }}
            </option>
        {% endfor %}
    </select>
{% endif %}
