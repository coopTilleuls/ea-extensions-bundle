{# @var field \EasyCorp\Bundle\EasyAdminBundle\Dto\FieldDto #}

{% set customOptions = field.customOptions %}
{% set fetchUrl = customOptions.get('resolvedFetchUrl') %}
{% set actions = customOptions.get('additionalActions') %}
{% set label = customOptions.get('label') %}

<div class="{{ customOptions.get('displayAsCard') ? 'card' }} {{ field.cssClass|default('') }}">
    <div class="card-body">
        {% if (label is not null and label is not same as(false)) or actions|length > 0 %}
            <div class="d-flex w-100 mb-2">
                <p class="flex-grow-1 mb-0">
                    {% if label is not null and label is not same as(false) %}{{ label|trans }}{% endif %}
                </p>
                <div class="ea-crud-field-global-actions d-flex">
                    {% for action in actions %}
                        {{ include(action.templatePath, { action: action }, with_context = false) }}
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% if customOptions.get('help') is not empty %}
            <div class="alert alert-info">{{ customOptions.get('help')|trans }}</div>
        {% endif %}

        {% if customOptions.get('showFilters') %}
            {{ include('@EAExtensions/crud_fields/filters_modal.html.twig') }}
        {% endif %}

        {% if customOptions.get('openActionsInModal') %}
            {{ include('@EAExtensions/crud_fields/action_modal.html.twig') }}
        {% endif %}

        {% if customOptions.get('lazy') %}
            <div class="ea-crud-field-lazy"
                 data-controller="ea-extensions--crud-field-lazy"
                 data-ea-extensions--crud-field-lazy-crud-path-value="{{ fetchUrl }}"
                 data-ea-extensions--crud-field-lazy-open-actions-in-modal-value="{{ customOptions.get('openActionsInModal') ? 'true' : 'false' }}">
                <div data-ea-extensions--crud-field-lazy-target="placeholder" class="d-flex flex-column align-items-center py-5 gap-3">
                    <div data-ea-extensions--crud-field-lazy-target="spinner" class="spinner-border text-secondary" role="status">
                        <span class="visually-hidden">Chargement…</span>
                    </div>
                    <button type="button"
                            data-ea-extensions--crud-field-lazy-target="loadButton"
                            data-action="ea-extensions--crud-field-lazy#load"
                            class="btn btn-sm btn-outline-secondary d-none">
                        Charger
                    </button>
                </div>
            </div>
        {% else %}
            <div class="ea-crud-field-eager"
                 data-controller="ea-extensions--crud-field-eager"
                 data-ea-extensions--crud-field-eager-crud-path-value="{{ fetchUrl }}"
                 data-ea-extensions--crud-field-eager-open-actions-in-modal-value="{{ customOptions.get('openActionsInModal') ? 'true' : 'false' }}">
                {{ render(fetchUrl) }}
            </div>
        {% endif %}
    </div>
</div>
