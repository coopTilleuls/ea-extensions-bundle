{#
    Extends forced_filters_index.html.twig (itself the real crud/index plus the "filters" patch
    for forced filters) so every block except "page_actions"/"filters" renders 100% unmodified.
    "page_actions" is patched only to gate the whole filters button behind CrudField's own
    showFilters() option — see the block below for why.
#}
{% extends '@EAExtensions/crud_fields/forced_filters_index.html.twig' %}

{# CrudField's own showFilters() option gates the whole filters button/feature — without it,
   vendor's own page_actions block would still show "Filtrer" for any target that happens to
   have filters configured, regardless of whether the CrudField asked for it. global_actions
   and batch_actions are untouched, resolved from whichever template actually defines them. #}
{% block page_actions %}
    {% if ea_extensions_crud_field_has_filters_button(filters) %}
        <div class="datagrid-filters">
            {{ block('filters') }}
        </div>
    {% endif %}
    {{ block('global_actions') }}
    {{ block('batch_actions') }}
{% endblock page_actions %}
