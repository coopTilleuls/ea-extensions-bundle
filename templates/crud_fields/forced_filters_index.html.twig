{#
    Extends the real crud/index template (vendor's, or the app's own theme override — see
    CrudFieldIndexTemplateExtension) so every block except "filters" renders 100% unmodified.
    "filters" is patched to exclude "forced" filters (declared through the hiddenFilters query
    param) from the applied-filters count badge, and to keep them on its reset link.
#}
{% extends ea_extensions_crud_field_parent_index_template() %}

{% block filters %}
    {% set hidden_filter_keys = app.request.query.all('hiddenFilters') %}
    {% set all_filters = app.request.query.all('filters') %}
    {% set forced_filters = all_filters|filter((value, key) => key in hidden_filter_keys) %}
    {% set applied_filters = all_filters|filter((value, key) => key not in hidden_filter_keys)|keys %}
    <div class="btn-group action-filters">
        <a href="#" data-href="{{ ea_url().setAction('renderFilters') }}" class="btn btn-secondary btn-labeled btn-labeled-right action-filters-button disabled {{ applied_filters ? 'action-filters-applied' }}" data-bs-toggle="modal" data-bs-target="#modal-filters">
            <twig:ea:Icon name="internal:filter" /> {{ t('filter.title', ea.i18n.translationParameters, 'EasyAdminBundle')|trans }}{% if applied_filters %} <span class="action-filters-button-count">({{ applied_filters|length }})</span>{% endif %}
        </a>
        {% if applied_filters %}
            <a href="{{ forced_filters is empty ? ea_url().unset('filters').setAction('index') : ea_url().set('filters', forced_filters).setAction('index') }}" class="btn btn-secondary action-filters-reset">
                <twig:ea:Icon name="internal:xmark" class="btn-icon" />
            </a>
        {% endif %}
    </div>
{% endblock filters %}
