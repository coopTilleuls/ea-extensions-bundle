{% trans_default_domain 'EasyAdminBundle' %}
{% set ea = ea() %}

{% if ea.crud.currentAction == 'detail' or not field.customOptions.get('renderAsSwitch') %}
    {% include "@!EasyAdmin/crud/field/boolean.html.twig" %}
{% else %}
    {% if field.value is not null %}
        <div class="form-check ea-switch-check"
            data-controller="ea-extensions--notification-toggle ea-extensions--notification-toggle-label"
            data-ea-extensions--notification-toggle-toggle-url-value="{{ field.customOptions.get('toggleUrl') }}"
            data-ea-extensions--notification-toggle-field-value="{{ field.property }}"
            data-ea-extensions--notification-toggle-reload-value="{{ field.property == 'treatment.pending' ? 'true' : 'false' }}"
            {% if field.formTypeOption('row_attr.custom-labels.true') is defined %}data-label-true="{{ field.formTypeOption('row_attr.custom-labels.true')|trans({}, 'EAExtensionsBundle', 'fr')|e('html_attr') }}"{% endif %}
            {% if field.formTypeOption('row_attr.custom-labels.false') is defined %}data-label-false="{{ field.formTypeOption('row_attr.custom-labels.false')|trans({}, 'EAExtensionsBundle', 'fr')|e('html_attr') }}"{% endif %}
        >
            <label class="form-check-label" for="{{ field.uniqueId }}">
                <twig:ea:Switch
                    id="{{ field.uniqueId }}"
                    checked="{{ field.value == true }}"
                    disabled="{{ field.formTypeOption('disabled') == true }}"
                    data-toggle-url="{{ field.customOptions.get('toggleUrl') }}"
                    data-action="change->ea-extensions--notification-toggle#toggle input->ea-extensions--notification-toggle-label#update"
                    {{ ...field.getFormTypeOption('attr') }}
                />
                {% if field.formTypeOption('row_attr.custom-labels') is defined %}
                    <span data-ea-extensions--notification-toggle-label-target="text">{{ field.formTypeOption('row_attr.custom-labels.' ~ (field.value ? 'true' : 'false'))|trans({}, 'EAExtensionsBundle', 'fr') }}</span>
                {% endif %}
            </label>
        </div>
    {% endif %}
{% endif %}
