{{ form_start(form, {attr: {'data-ea-extensions--customizable-columns-modal-target': 'form'}}) }}
    <div class="ea-extensions-column-list" data-controller="ea-extensions--column-handler">
        {% for child in form %}
            <div class="ea-extensions-column-row" data-ea-extensions--column-handler-target="row">
                <button type="button" class="btn btn-sm ea-extensions-column-row-up" data-action="ea-extensions--column-handler#moveUp" aria-label="Monter">
                    <i class="fa fa-chevron-up"></i>
                </button>
                <button type="button" class="btn btn-sm ea-extensions-column-row-down" data-action="ea-extensions--column-handler#moveDown" aria-label="Descendre">
                    <i class="fa fa-chevron-down"></i>
                </button>
                {{ form_widget(child) }}
                {{ form_label(child) }}
            </div>
        {% endfor %}
    </div>
    <div class="ea-extensions-column-actions">
        <button type="submit" class="btn btn-secondary" data-action="ea-extensions--customizable-columns-modal#reset">Réinitialiser</button>
        <button type="submit" class="btn btn-primary">Appliquer</button>
    </div>
{{ form_end(form) }}
