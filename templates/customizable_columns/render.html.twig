{{ form_start(form, {attr: {id: 'ea-extensions-columns-form'}}) }}
    <div class="ea-extensions-column-list" data-controller="coop-tilleuls--ea-extensions--column-handler">
        {% for child in form %}
            {% if child.vars.name not in ['_token', 'save'] %}
                <div class="ea-extensions-column-row d-flex align-items-center" data-coop-tilleuls--ea-extensions--column-handler-target="row">
                    <div class="form-check flex-grow-1">
                        {{ form_widget(child) }}
                        {{ form_label(child) }}
                    </div>
                    <div class="d-flex flex-column align-items-center ms-3">
                        <button type="button" class="btn btn-sm p-0 text-body-secondary" data-action="coop-tilleuls--ea-extensions--column-handler#moveUp" aria-label="Monter">
                            <i class="fas fa-chevron-up"></i>
                        </button>
                        <button type="button" class="btn btn-sm p-0 text-body-secondary" data-action="coop-tilleuls--ea-extensions--column-handler#moveDown" aria-label="Descendre">
                            <i class="fas fa-chevron-down"></i>
                        </button>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
    {% if form.save is defined %}
        {% do form.save.setRendered %}
        <div class="card p-3 my-3 ea-extensions-save-switch">
            <label class="d-flex align-items-center justify-content-between gap-3" for="{{ form.save.vars.id }}">
                <span class="text-nowrap"><i class="fas fa-star me-2"></i>{{ form.save.vars.label }}</span>
                <twig:ea:Switch
                    name="{{ form.save.vars.full_name }}"
                    id="{{ form.save.vars.id }}"
                    value="{{ form.save.vars.value }}"
                    :checked="form.save.vars.checked"
                />
            </label>
        </div>
    {% endif %}
{{ form_end(form) }}
