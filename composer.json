{
    "name": "coop-tilleuls/ea-extensions-bundle",
    "description": "EasyAdmin extensions bundle",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "doctrine/orm": "^2.17|^3.0",
        "easycorp/easyadmin-bundle": "^5.5",
        "psr/log": "^3.0",
        "symfony/clock": "^6.4|^7.0|^8.0",
        "symfony/config": "^6.4|^7.0",
        "symfony/dependency-injection": "^6.4|^7.0",
        "symfony/event-dispatcher": "^6.4|^7.0",
        "symfony/expression-language": "^6.4|^7.0",
        "symfony/form": "^6.4|^7.0",
        "symfony/http-foundation": "^6.4|^7.0",
        "symfony/http-kernel": "^6.4|^7.0",
        "symfony/property-access": "^6.4|^7.0",
        "symfony/routing": "^6.4|^7.0",
        "symfony/security-bundle": "^6.4|^7.0",
        "symfony/security-core": "^6.4|^7.0",
        "symfony/translation-contracts": "^3.0",
        "symfony/twig-bundle": "^6.4|^7.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.11",
        "friendsofphp/php-cs-fixer": "^3.84",
        "league/flysystem": "^3.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.1",
        "symfony/browser-kit": "^6.4|^7.0",
        "symfony/css-selector": "^6.4|^7.0",
        "symfony/framework-bundle": "^6.4|^7.0",
        "symfony/mercure": "^0.6.3|^1.0",
        "symfony/messenger": "^6.4|^7.0",
        "symfony/phpunit-bridge": "^7.0",
        "symfony/process": "^6.4|^7.0",
        "symfony/translation": "^6.4|^7.0",
        "symfony/ux-twig-component": "^2.32|^3.0",
        "symfony/var-exporter": "^7.2.5",
        "twig/extra-bundle": "^3.0"
    },
    "suggest": {
        "league/flysystem": "To enable the CRUD export feature (coop_tilleuls_ea_extensions.crud_export.enabled).",
        "symfony/mercure": "To publish real-time notification events over Mercure (Notifications feature).",
        "symfony/messenger": "To enable the CRUD export feature's async export mode.",
        "symfony/process": "To enable the CRUD export feature's XLSX export (CSV-to-XLSX conversion)."
    },
    "autoload": {
        "psr-4": {
            "CoopTilleuls\\Bundle\\EAExtensionsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoopTilleuls\\Bundle\\EAExtensionsBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run",
        "rector-fix": "rector process"
    }
}
