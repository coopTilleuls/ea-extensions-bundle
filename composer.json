{
    "name": "coop-tilleuls/ea-extensions-bundle",
    "description": "EasyAdmin extensions bundle",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "doctrine/orm": "^2.17|^3.0",
        "easycorp/easyadmin-bundle": "^5.5",
        "symfony/config": "^6.4|^7.0",
        "symfony/dependency-injection": "^6.4|^7.0",
        "symfony/form": "^6.4|^7.0",
        "symfony/http-kernel": "^6.4|^7.0",
        "symfony/routing": "^6.4|^7.0",
        "symfony/security-bundle": "^6.4|^7.0",
        "symfony/twig-bundle": "^6.4|^7.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.11",
        "friendsofphp/php-cs-fixer": "^3.84",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.1",
        "symfony/browser-kit": "^6.4|^7.0",
        "symfony/css-selector": "^6.4|^7.0",
        "symfony/framework-bundle": "^6.4|^7.0",
        "symfony/phpunit-bridge": "^7.0",
        "symfony/ux-twig-component": "^2.32|^3.0"
    },
    "conflict": {
        "symfony/asset": ">=8.0",
        "symfony/cache": ">=8.0",
        "symfony/clock": ">=8.0",
        "symfony/console": ">=8.0",
        "symfony/dom-crawler": ">=8.0",
        "symfony/error-handler": ">=8.0",
        "symfony/event-dispatcher": ">=8.0",
        "symfony/filesystem": ">=8.0",
        "symfony/finder": ">=8.0",
        "symfony/http-foundation": ">=8.0",
        "symfony/intl": ">=8.0",
        "symfony/mime": ">=8.0",
        "symfony/options-resolver": ">=8.0",
        "symfony/password-hasher": ">=8.0",
        "symfony/process": ">=8.0",
        "symfony/property-access": ">=8.0",
        "symfony/property-info": ">=8.0",
        "symfony/routing": ">=8.0",
        "symfony/security-core": ">=8.0",
        "symfony/security-csrf": ">=8.0",
        "symfony/security-http": ">=8.0",
        "symfony/stopwatch": ">=8.0",
        "symfony/string": ">=8.0",
        "symfony/translation": ">=8.0",
        "symfony/twig-bridge": ">=8.0",
        "symfony/type-info": ">=8.0",
        "symfony/uid": ">=8.0",
        "symfony/validator": ">=8.0",
        "symfony/var-dumper": ">=8.0",
        "symfony/var-exporter": ">=8.0"
    },
    "autoload": {
        "psr-4": {
            "CoopTilleuls\\Bundle\\EAExtensionsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoopTilleuls\\Bundle\\EAExtensionsBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run",
        "rector-fix": "rector process"
    }
}
